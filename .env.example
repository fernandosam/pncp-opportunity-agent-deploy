# Non-secret deployment settings. Copy to .env; never print rendered config.
APP_SOURCE=../pncp-opportunity-agent
# Use an approved immutable release tag; keep the previous images for rollback.
APP_IMAGE_TAG=local
APP_URL=http://localhost:3000
WEB_BIND=127.0.0.1
WEB_PORT=3000
PUBLIC_HOST=localhost
# Local HTTPS is loopback-only; public exposure needs an explicit operator decision.
EDGE_BIND=127.0.0.1
# Real keys belong only in ignored .env.app/.env.worker (chmod 600).
# Worker and HTTPS are opt-in profiles, not started by default.
# Real magic-link auth in production requires HTTPS APP_URL; see docs/local-onboarding.md.
